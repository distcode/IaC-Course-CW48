
{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "0.0.0.0",
    "parameters": {
        "iacLocation" :{
            "type": "string",
            "defaultValue": "North Europe",
            "AllowedValues": [
                "North Europe",
                "West Europe",
                "East US",
                "Austria East"
            ],
            "metadata":{
                "description": "The name of the Location."
            }
        }
    },
    "variables": {},
    "resources": [],
    "outputs": {
        "Location": {
            "type": "string",
            "value": "[parameters('iacLocation')]"
        }
    }
}